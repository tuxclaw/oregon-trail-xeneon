    <file alias="tree.png">resources/sprites/tree.png</file>
    <file alias="hills.png">resources/sprites/hills.png</file>
    <file alias="ground.png">resources/sprites/ground.png</file>
    <file alias="ground_snow.png">resources/sprites/ground_snow.png</file>
